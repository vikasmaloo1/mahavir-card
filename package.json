{
  "name": "mahavir-card",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "npm run db:migrate && npm run db:seed:rate && npm run rate:verify && npm run artwork:verify",
    "db:deploy:vercel": "tsx scripts/vercel-database.ts",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx scripts/seed-rate.ts",
    "db:seed:rate": "tsx scripts/seed-rate.ts",
    "db:seed:terms": "tsx scripts/seed-terms.ts",
    "vercel-build": "npm run db:deploy:vercel && next build",
    "rate:verify": "tsx scripts/verify-rate-catalog.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "api:docs": "tsx scripts/api-docs.ts",
    "artwork:verify": "tsx scripts/verify-artwork-rules.ts",
    "notices:verify": "tsx scripts/verify-notices-banners.ts",
    "storage:verify": "node --conditions=react-server --import tsx scripts/verify-r2.ts",
    "storage:api-verify": "node --import tsx scripts/verify-storage-api.ts",
    "customer-flow:verify": "node --conditions=react-server --import tsx scripts/verify-customer-flow.ts",
    "test:storage": "node --conditions=react-server --import tsx --test tests/storage-policies.test.ts",
    "test:listing-pricing": "node --import tsx --test tests/product-listing-pricing.test.ts",
    "test:catalog-routing": "node --import tsx --test tests/catalog-routing.test.ts",
    "test:customer-flow": "node --import tsx --test tests/customer-flow-validation.test.ts",
    "test:payments": "node --conditions=react-server --import tsx --test tests/payment-security.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "@aws-sdk/s3-request-presigner": "^3.1118.0",
    "@types/swagger-ui-react": "^5.18.0",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "swagger-ui-react": "^5.32.14",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
